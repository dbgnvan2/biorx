# BioRx web app configuration.
#
# Copy to .env for a local run (.env is gitignored), or set these as variables
# in your deployment. Nothing here has a safe default that can be guessed:
# ACCESS_CODE and SESSION_SECRET must be set, and KEY_ENC_SECRET is required
# before anyone can store a personal API key.

# ── Access ────────────────────────────────────────────────────────────────────
# The shared code colleagues type to get in. Anyone with it can run searches and
# spend the owner key up to the daily cap below, so treat it as a password and
# change it when someone leaves.
ACCESS_CODE=change-me

# Signs the session cookie. Any long random string; generate one with
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, a new one is generated per process and everyone is signed out on
# every restart.
SESSION_SECRET=

# Encrypts personal API keys at rest. REQUIRED before anyone can save their own
# key — without it the app runs, but the "save key" button reports that storage
# is disabled. It is never generated automatically: a secret written next to the
# data it protects is not protection. Generate as above and keep it somewhere
# you can recover, because changing it makes stored keys unreadable.
KEY_ENC_SECRET=

# Set to 1 ONLY for a local http://localhost run; it drops the Secure flag from
# the session cookie. Never set it in a deployment.
# SESSION_COOKIE_INSECURE=1

# ── LLM backend ───────────────────────────────────────────────────────────────
# Which provider to use for anyone who has not added their own key:
#   ollama    — a local model; no key, no cost, not reachable from a container
#   deepseek  — OpenAI-compatible API
#   anthropic — Anthropic Messages API
LLM_PROVIDER=anthropic

# The server owner's keys. Whichever matches LLM_PROVIDER is the default for
# every user who has not supplied their own.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Override the model. Defaults live in llm_config.yaml
# (anthropic: claude-sonnet-5, deepseek: deepseek-chat).
# ANTHROPIC_MODEL=claude-opus-5
# DEEPSEEK_MODEL=deepseek-reasoner

# How many summaries each user may bill to the OWNER's key per day. Users on
# their own key are not capped. This is the ceiling on what a leaked access code
# can spend. Default 25.
# SUMMARY_DAILY_CAP_PER_USER=25

# ── Storage ───────────────────────────────────────────────────────────────────
# Everything the app writes goes here. Point it at a mounted volume in a
# deployment; a container filesystem does not survive a redeploy.
DATA_DIR=/data

# Override the database path directly if it should not sit under DATA_DIR.
# BIORX_DB_PATH=/data/biorxiv.db

# How long a write waits for a competing write, in milliseconds. Default 10000.
# BIORX_DB_BUSY_TIMEOUT_MS=10000

# Where the provider/model configuration lives. Defaults to llm_config.yaml
# beside the code; point it elsewhere to change models without rebuilding.
# BIORX_LLM_CONFIG=/data/llm_config.yaml

# ── Politeness ────────────────────────────────────────────────────────────────
# Sent to OpenAlex so they can contact you about traffic. Not a secret.
BIORX_CONTACT_EMAIL=you@example.com
